# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[{*.{js,mjs,ts,tsx,json,jsonc,css,yml,yaml,toml,sh},.github/**}]
indent_style = space
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false
